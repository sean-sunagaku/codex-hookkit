{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python examples/python_hooks/codex_review/request_review.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python examples/python_hooks/codex_review/run_review.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
